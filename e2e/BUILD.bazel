load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@tbhb_rules//repo:defs.bzl", "repo_files")
load("@tbhb_rules_typescript//:defs.bzl", "vitest_test")

repo_files()

# The deploys' pre- and post-deploy check against a deployed Worker.
js_binary(
    name = "check",
    data = ["check.mjs"],
    entry_point = "main.mjs",
    visibility = ["//:__pkg__"],
)

# The check against the Worker's own entry point, with coverage.
vitest_test(
    name = "check_test",
    srcs = glob(["*.mjs"]) + ["//:worker_srcs"],
    config = "vitest.config.mjs",
    node_modules = ["//:node_modules"],
)
