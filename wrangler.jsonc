//
// The Worker in each environment. The ops repository's OpenTofu owns the
// custom domains (go-stg.tbhb.dev and go.tbhb.dev), so wrangler manages no
// routes and serves nothing on workers.dev. CF_VERSION_METADATA gives the
// Worker its version id, which it returns on every response so the deploy's
// checks can tell which version answered.
{
  "name": "go-tbhb-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "env": {
    "stg": {
      "name": "go-tbhb-dev-stg",
      "workers_dev": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" }
    },
    "prd": {
      "name": "go-tbhb-dev-prd",
      "workers_dev": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" }
    }
  }
}
