"""Root workspace for building, testing and deploying go.tbhb.dev."""

module(name = "go_tbhb_dev")

# Shared lint, format and test rules, with default tool pins. Not on the BCR
# yet, so it comes from Git, pinned to a commit on the rules repository's main
# branch. Every tbhb_rules* module moves together. Local development
# points at a clone instead, with
# `common --override_module=tbhb_rules=../rules` in .bazelrc.user.
bazel_dep(name = "tbhb_rules", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "tbhb_rules",
    commit = "c13ddff4294a73c643ad6cafb7ca570f6c3add0b",
    remote = "https://github.com/tbhb-dev/rules.git",
)

# The TypeScript checks (tsc, Biome, typescript-eslint, knip,
# dependency-cruiser, Vitest, Stryker and pnpm audit), a nested module of the
# same repository with its own pinned toolchain. Same pin as tbhb_rules
# (main after tbhb-dev/rules#22);
# locally, `common --override_module=tbhb_rules_typescript=../rules/typescript`.
bazel_dep(name = "tbhb_rules_typescript", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "tbhb_rules_typescript",
    commit = "c13ddff4294a73c643ad6cafb7ca570f6c3add0b",
    remote = "https://github.com/tbhb-dev/rules.git",
    strip_prefix = "typescript",
)

# The Worker rules (bundle, generated types, tested deploys), from the same
# repository, with wrangler pinned there. Same pin as tbhb_rules; locally,
# `common --override_module=tbhb_rules_cloudflare=../rules/cloudflare`.
bazel_dep(name = "tbhb_rules_cloudflare", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "tbhb_rules_cloudflare",
    commit = "c13ddff4294a73c643ad6cafb7ca570f6c3add0b",
    remote = "https://github.com/tbhb-dev/rules.git",
    strip_prefix = "cloudflare",
)

# The Worker's own npm packages (package.json, pnpm-lock.yaml), every one
# pinned by integrity hash, with no lifecycle script allowed to run.
bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "bazel_lib", version = "3.7.0")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    data = ["//:package.json"],
    lifecycle_hooks = {"*": []},
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

# pnpm 12, the version tbhb_rules uses, for regenerating the lock:
# bazel run -- @pnpm//:pnpm --dir "$PWD" install --lockfile-only
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "12.16.1",
    pnpm_version_integrity = "sha512-CR0d7nknV1Zhsl2rPCrjHK/BxU1rce1qZgDPDByxBDSkR+rhQBXxsj4ua+3u1535SpMuIWTSgyKA3OP7MvZW0Q==",
)
use_repo(pnpm, "pnpm")

# Dev dependencies: tooling that only this workspace needs.
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)
bazel_dep(name = "bazelrc-preset.bzl", version = "1.10.0", dev_dependency = True)

# Stable paths and PATH shims (.bazel_env/bin) for the Bazel-pinned tools,
# which git hooks and editors call without starting Bazel.
bazel_dep(name = "bazel_env.bzl", version = "0.10.0", dev_dependency = True)

# Tool binaries: tbhb_rules' pins, one hub repository per tool. This module
# refers to the same labels for its own targets and its bazel_env shims, so
# each tool has one pin; override_repo swaps one if this repository ever
# needs to.
tools = use_extension("@tbhb_rules//pins:extensions.bzl", "tools")
use_repo(
    tools,
    "tbhb_rules_actionlint",
    "tbhb_rules_cog",
    "tbhb_rules_editorconfig_checker",
    "tbhb_rules_git",
    "tbhb_rules_gitleaks",
    "tbhb_rules_rumdl",
    "tbhb_rules_ryl",
    "tbhb_rules_shellcheck",
    "tbhb_rules_shfmt",
    "tbhb_rules_tombi",
    "tbhb_rules_vale",
    "tbhb_rules_zizmor",
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Vale style packages, one per `Packages` URL in .vale.ini and in the same
# order, pinned by digest. //:vale_test syncs from these instead of the
# network, and `bazel run //:vale_sync` writes them into .vale/ for editors.
# Move a version here and in .vale.ini together.
http_file(
    name = "vale_google",
    dev_dependency = True,
    downloaded_file_path = "Google.zip",
    sha256 = "4b67fca1f2a88595b2a578ab98bbf3017a23af677b04f93e862843f3ea1a9a0b",
    url = "https://github.com/errata-ai/Google/releases/download/v0.7.1/Google.zip",
)

http_file(
    name = "vale_write_good",
    dev_dependency = True,
    downloaded_file_path = "write-good.zip",
    sha256 = "2960ef10861ddc7dc76292a4967eb3789bf05ca24f862042f6d15f53332887f0",
    url = "https://github.com/errata-ai/write-good/releases/download/v0.4.1/write-good.zip",
)

http_file(
    name = "vale_proselint",
    dev_dependency = True,
    downloaded_file_path = "proselint.zip",
    sha256 = "48b1fb481ba44f6505d44346b283f6cdc74efd234f913bbdb09bf34420fab81c",
    url = "https://github.com/errata-ai/proselint/releases/download/v0.3.4/proselint.zip",
)

http_file(
    name = "vale_ai_tells",
    dev_dependency = True,
    downloaded_file_path = "ai-tells.zip",
    sha256 = "f8d1e981abbfbac1aa092d1623a1ac9bc935f0b15e8071e7a072915abddf0570",
    url = "https://github.com/tbhb/vale-ai-tells/releases/download/v1.37.0/ai-tells.zip",
)

http_file(
    name = "vale_ai_tells_experimental",
    dev_dependency = True,
    downloaded_file_path = "ai-tells-experimental.zip",
    sha256 = "d628f719afead6812028c2a31802d87c7572a931d9b16e94f2874d95e9d597b8",
    url = "https://github.com/tbhb/vale-ai-tells/releases/download/v1.37.0/ai-tells-experimental.zip",
)
